<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.forwardmeasure.keycloak</groupId>
  <artifactId>forwardmeasure-keycloak-authorization-policy-provider</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>ForwardMeasure Keycloak Authorization :: Organization Role Policy Provider</name>
  <description>
    Real fix for a confirmed Keycloak 26.7.4 gap: a role granted via Organization-group membership
    is invisible to every built-in Authorization Services policy type. See
    OrganizationRolePolicyProvider's own javadoc for the full, decompiled-source-verified rationale.
    Deployed as a Keycloak provider JAR (dropped into /opt/keycloak/providers/, requires a
    `kc.sh build` re-run to register - see this chart's own Dockerfile).
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Matches the real, digest-pinned Keycloak version this chart deploys - see
         forwardmeasure-platform/deploy/helmfile/environments/image-versions.yaml. Every dependency
         below is `provided` scope: Keycloak's own runtime supplies these classes; this artifact
         only ever contributes its own two classes plus the SPI registration file. -->
    <keycloak.version>26.7.4</keycloak.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jboss.logging</groupId>
      <artifactId>jboss-logging</artifactId>
      <version>3.6.1.Final</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-core</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>forwardmeasure-keycloak-authorization-policy-provider</finalName>
  </build>
</project>
