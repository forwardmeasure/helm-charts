<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.forwardmeasure.keycloak</groupId>
  <artifactId>forwardmeasure-keycloak-authorization-policy-provider</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>ForwardMeasure Keycloak Authorization :: Organization Role Policy Provider</name>
  <description>
    Real fix for a confirmed Keycloak 26.7.4 gap: a role granted via Organization-group membership
    is invisible to every built-in Authorization Services policy type. See
    OrganizationRolePolicyProvider's own javadoc for the full, decompiled-source-verified rationale.
    Deployed as a Keycloak provider JAR (dropped into /opt/keycloak/providers/, requires a
    `kc.sh build` re-run to register - see this chart's own Dockerfile).
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Matches the real, digest-pinned Keycloak version this chart deploys - see
         forwardmeasure-platform/deploy/helmfile/environments/image-versions.yaml. Every dependency
         below is `provided` scope: Keycloak's own runtime supplies these classes; this artifact
         only ever contributes its own two classes plus the SPI registration file. Also drives the
         keycloak-parent BOM import below, which manages every dependency's real version - no version
         literal anywhere else in this file, so nothing here can drift out of sync with the real
         Keycloak release the way a hand-maintained jboss-logging version once did (caught live:
         a guessed 3.6.1.Final differed from the real bundled 3.6.2.Final and went unnoticed until
         checked directly against the real image). -->
    <keycloak.version>26.7.4</keycloak.version>
  </properties>

  <!-- Imports Keycloak's own real release BOM so every dependency below resolves to exactly the
       version that Keycloak ${keycloak.version} itself was built and released with - including
       transitive-looking ones like jboss-logging, which is NOT actually a transitive dependency of
       keycloak-server-spi/keycloak-core (compilation fails without declaring it directly) but IS
       managed by this BOM, confirmed empirically by importing it and checking the resolved version
       matches the real jar Keycloak's own image bundles. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-parent</artifactId>
        <version>${keycloak.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.jboss.logging</groupId>
      <artifactId>jboss-logging</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-core</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>forwardmeasure-keycloak-authorization-policy-provider</finalName>
  </build>
</project>
